# Supabase dashboard > Connect > Session pooler. Replace the password. Do not add ?sslmode=...
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Supabase dashboard > Project Settings > API. Either key name works: newer dashboards
# call it the "publishable" key, older ones the "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
